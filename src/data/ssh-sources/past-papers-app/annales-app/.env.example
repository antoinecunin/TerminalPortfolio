# CONFIGURATION TEMPLATE - COPY TO .env AND .env.dev
# =============================================================

# Common variables
# Docker Compose project name. Defaults to the directory name, which every
# checkout shares, so two copies on one host see each other as one deployment
# and starting either one tears down the other. Set this to something unique
# if the machine already runs an instance. Changing it on an existing install
# orphans its volumes, so leave it alone once data has been written.
# COMPOSE_PROJECT_NAME=annales-app
API_HEALTH_PATH=/api/health
MONGO_RETRY_MS=2000
MONGO_MAX_RETRIES=60
S3_REGION=garage

# S3 / Garage storage - MUST BE CONFIGURED
# The two values below are deliberately invalid: Garage will reject them until
# you replace them. That is on purpose, so that no instance can ever run on the
# storage credentials published in the public repository.
# These keys are never generated for you: on startup, start.ts imports into
# Garage exactly what is written here. Generate your own with:
#   S3_ACCESS_KEY : echo "GK$(openssl rand -hex 12)"   ("GK" followed by 12 hex bytes)
#   S3_SECRET_KEY : openssl rand -hex 32               (32 hex bytes)
S3_ACCESS_KEY=CHANGE_ME_SEE_COMMENT_ABOVE
S3_SECRET_KEY=CHANGE_ME_SEE_COMMENT_ABOVE
S3_USE_SSL=false
GARAGE_ADMIN_TOKEN=annales-garage-admin-token

# Environment-specific variables
API_PORT=3000
WEB_PORT=8080
VITE_PORT=5173
MONGO_PORT=27017
MONGO_EXTERNAL_PORT=27017
GARAGE_S3_EXTERNAL_PORT=3900
GARAGE_ADMIN_EXTERNAL_PORT=3903
API_EXTERNAL_PORT=3000
MEILI_EXTERNAL_PORT=7700
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
MONGO_URI=mongodb://mongo:27017/annales
S3_ENDPOINT=garage:3900
S3_BUCKET=annales
NODE_ENV=production
MEILI_HOST=http://meili:7700
# Morgan log formats: 'dev' (development), 'combined' (production), 'common', 'short', 'tiny'
API_LOG_LEVEL=combined

# Authentication - MUST BE CONFIGURED
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:8080

# Meili search engine - MUST BE CONFIGURED
# Master key authenticating the API against Meili (16 bytes minimum, or Meili
# refuses to start in production)
MEILI_MASTER_KEY=CHANGE_ME_VERY_LONG_RANDOM_MEILI_MASTER_KEY

# Email / SMTP - MUST BE CONFIGURED
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM_NAME="Exam Archive - My University"
EMAIL_FROM_ADDRESS=YOUR_SENDER_EMAIL_ADDRESS

# First admin user - OPTIONAL (created automatically on startup)
# All four variables are required together: the bootstrap is skipped if any is missing,
# and it only runs when no admin exists yet.
# The address must match one of the allowedDomains in instance.config.json, and the
# password needs at least 8 characters including a letter and a digit. Otherwise the
# API logs the reason and carries on without creating the account.
INITIAL_ADMIN_EMAIL=admin@students.example.edu
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INITIAL_ADMIN_FIRSTNAME=Admin
INITIAL_ADMIN_LASTNAME=System

# CONFIGURATION INSTRUCTIONS:
# ==============================
# 1. Copy this file to .env (production) and .env.dev (development)
# 2. You MUST change:
#    - JWT_SECRET: generate a very long, random secret key
#    - MEILI_MASTER_KEY: Meili master key (16 characters minimum)
#    - S3_ACCESS_KEY and S3_SECRET_KEY: see the "S3 / Garage storage" block above,
#      the shipped values are invalid and will break storage
#    - SMTP_USER: your SMTP username
#    - SMTP_PASS: your SMTP password
#    - EMAIL_FROM_ADDRESS: your sender email address
#    - FRONTEND_URL: the public URL of your frontend
#    - INITIAL_ADMIN_PASSWORD: password of the first admin (in production)
# 3. Adjust the remaining variables to suit your environment
#
# FIRST ADMIN:
# ==============
# - In production, set the INITIAL_ADMIN_* variables to create the first admin
#   user automatically when the API starts
# - The admin is only created if no admin exists in the database
# - Keep these variables after the account is created. INITIAL_ADMIN_EMAIL designates
#   the only account allowed to manage roles, and the bulk import script logs in with
#   INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD. If you change the admin password
#   from the interface, update INITIAL_ADMIN_PASSWORD here too.
#
# SECURITY:
# =========
# - NEVER commit .env files to git
# - Use strong, unique passwords
# - Change every default key before going to production
